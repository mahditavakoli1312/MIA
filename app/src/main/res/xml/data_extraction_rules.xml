<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup/transfer rules for API 31+. See backup_rules.xml for the API 30 and below equivalent.
-->
<data-extraction-rules>
    <!--
       mia_secrets.xml holds the encrypted API keys *and* the Tink keyset that protects them,
       sealed with an Android Keystore key that leaves neither the device nor this app. Carrying
       the file to a phone whose Keystore holds a different key leaves the two unable to decrypt
       each other, which fails app startup — see SecretStore.openPrefs. Excluded on both paths;
       the keys are re-enterable in Settings.
    -->
    <cloud-backup>
        <exclude domain="sharedpref" path="mia_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mia_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
