<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for API 30 and below (android:fullBackupContent). API 31+ uses
   data_extraction_rules.xml instead; both exclude the same file for the same reason.
-->
<full-backup-content>
    <!--
       mia_secrets.xml holds the encrypted API keys *and* the Tink keyset that protects them,
       sealed with an Android Keystore key that is never backed up. Restoring the file onto a
       device whose Keystore holds a different key leaves the two unable to decrypt each other,
       which fails app startup — see SecretStore.openPrefs. Nothing here is worth restoring
       anyway: the keys are re-enterable in Settings.
    -->
    <exclude domain="sharedpref" path="mia_secrets.xml" />
</full-backup-content>
